# LLM Configuration
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# Ollama (alternative)
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# TTS Configuration
TTS_PROVIDER=openai_realtime
TTS_VOICE=alloy
TTS_FORMAT=mp3
TTS_QUALITY=standard

# Embeddings
EMBEDDING_MODEL=text-embedding-3-small

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Application
APP_PORT=8501
DEBUG=false
