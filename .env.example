# Reglages d'un poste — gabarit. Le fichier reel est `.env`, jamais versionne.
#
# Depuis la phase 0 de C48 (decision 4 d'AF), le chat est **local par defaut** :
# ne rien regler donne Ollama, et aucun octet ne quitte le poste. Un fournisseur
# distant se nomme explicitement, ci-dessous, et c'est un geste qu'on ecrit.

# --- Chat -------------------------------------------------------------------
# ollama (defaut, local) | openai (distant, sur demande explicite)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3

# A ne remplir que si LLM_PROVIDER=openai. **Aucun contenu de norme, de
# Techniques de l'Ingenieur ni de piece client ne doit passer par ce chemin.**
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- Synthese vocale --------------------------------------------------------
# Limite a connaitre : il n'existe pas encore de chemin local pour la voix dans
# ce depot. `tts_service.py` appelle OpenAI, et rien d'autre : un texte lu a
# voix haute **part vers un service externe**.
TTS_PROVIDER=openai
TTS_VOICE=alloy
TTS_FORMAT=mp3
TTS_QUALITY=standard

# --- Encodage des morceaux --------------------------------------------------
# Reglage **non lu aujourd'hui** : `embedding_service.py` fixe lui-meme un
# modele local (`BAAI/bge-small-en-v1.5`) par FastEmbed. La ligne est gardee
# telle quelle plutot que corrigee en douce : la phase 1 tranchera ou vit ce
# choix, et le dira.
EMBEDDING_MODEL=text-embedding-3-small

# --- Base de vecteurs -------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333

# --- Divers -----------------------------------------------------------------
# APP_PORT ne sert plus au chemin principal : les deux cadres d'application
# sont ranges sous `_range/2026-11-12_c48/`. Garde pour ce qui y dort.
APP_PORT=8501
DEBUG=false
